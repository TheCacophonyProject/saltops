[Unit]
Description=Cacophony Project Python Thermal Recorder
DefaultDependencies=no
Wants=network-pre.target
Before=network-pre.target
After=local-fs.target systemd-modules-load.service

[Service]
Type=simple
ExecStart=/home/pi/.venv/classifier/bin/pi_classify
Restart=always
RestartSec=3s

[Install]
WantedBy=multi-user.target